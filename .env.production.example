# Copy this file to .env.production and fill in real values.
# .env.production is gitignored and NEVER committed.
# Generate strong passwords: python3 -c "import secrets; print(secrets.token_urlsafe(24))"

# Main analytics database
DB_NAME=ai_analytics
DB_USER=postgres
DB_PASSWORD=REPLACE_ME

# Superset metadata database
SUPERSET_DB_NAME=superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=REPLACE_ME

# Superset app
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SUPERSET_SECRET_KEY=REPLACE_ME_HEX_64_CHARS
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=REPLACE_ME

# LLM provider — Groq API
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_REPLACE_ME
GROQ_MODEL=openai/gpt-oss-120b

# AWS region (only relevant if you ever switch LLM_PROVIDER=bedrock)
AWS_REGION=eu-central-1
